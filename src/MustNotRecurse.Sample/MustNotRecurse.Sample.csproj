<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CallgraphClosure.Core\CallgraphClosure.Core.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)..\MustNotRecurse\bin\$(Configuration)\netstandard2.0\MustNotRecurse.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\CallgraphClosure.Core\bin\$(Configuration)\netstandard2.0\CallgraphClosure.Core.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CallgraphClosure.Attributes\bin\$(Configuration)\netstandard2.0\CallgraphClosure.Attributes.dll" />
  </ItemGroup>
</Project>
